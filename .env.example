# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=aapnosaath_care
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Security & CORS
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=60

# Public Configuration Settings
PUBLIC_ORG_NAME=AapnoSaath Care
PUBLIC_SERVICE_CITY=Vadodara
PUBLIC_SERVICE_STATE=Gujarat
PUBLIC_SERVICE_COUNTRY=India
PUBLIC_SUPPORT_EMAIL=enquiry@aapnosaathcare.example.in
PUBLIC_SUPPORT_PHONE=+91-98765-43210
PUBLIC_PRIVACY_VERSION=v1.0
PUBLIC_TERMS_VERSION=v1.0

# Gemini AI Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_RATE_LIMIT_LIMIT=20
AI_RATE_LIMIT_TTL=60

# Free Email Sending Configuration (Nodemailer)
# Free Gmail SMTP (500 free emails/day) or Brevo / Resend
# Leave SMTP_USER and SMTP_PASS empty for automatic zero-config Ethereal test inbox
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_generated_brevo_smtp_key
SMTP_FROM="AapnoSaath Care" <enquiriesataapnosaathcare@gmail.com>

